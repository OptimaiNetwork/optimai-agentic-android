<?xml version="1.0" encoding="utf-8"?>
<!-- Release builds speak HTTPS only. Debug builds add a local development
     exception in app/src/debug/res/xml/network_security_config.xml. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
